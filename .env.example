# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All variables here are read server-side only — none are prefixed NEXT_PUBLIC_,
# so none of them are ever exposed to the browser.

# Required for the "Request My Free Assessment" contact form to actually send email
# (src/app/api/contact/route.ts). Get a key at https://resend.com — the sending domain
# (fireloans.com.au) must be verified in the Resend dashboard before it can send from
# noreply@fireloans.com.au. Without this set, form submissions fail with a clear error
# rather than silently disappearing.
RESEND_API_KEY=

# Optional secondary news sources (src/lib/news/). The /news page works fully without
# these — RSS feeds are the primary source and need no key. Adding these just widens
# coverage.
NEWSDATA_API_KEY=
GNEWS_API_KEY=
